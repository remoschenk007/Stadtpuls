## ÖFFNUNGSZEITEN — FORMAT & FUNKTIONEN

```javascript
// Format in Supabase: ["Mo 09:00:00-18:00:00", "Di 09:00:00-18:00:00", ...]

function isOffe(oz) {
  if (!oz || !Array.isArray(oz) || !oz.length) return false;
  const now = new Date();
  const h = now.getHours();
  const day = ['So','Mo','Di','Mi','Do','Fr','Sa'][now.getDay()];
  const s = oz.find(o => o && o.includes(day));
  if (!s) return false;
  const m = s.match(/(\d{2}):(\d{2}):00-(\d{2}):(\d{2}):00/);
  if (!m) return false;
  return h >= parseInt(m[1]) && h < parseInt(m[3]);
}

// OZ-Grid 7 Tage — heute mit ◀ markiert
function buildOzGrid(oz) {
  const DAYS = ['So','Mo','Di','Mi','Do','Fr','Sa'];
  const today = new Date().getDay();
  return '<div class="oz-grid">' + DAYS.map((d, i) => {
    const s = (oz||[]).find(o => o && o.includes(d));
    const m = s ? s.match(/(\d{2}):(\d{2}):00-(\d{2}):(\d{2}):00/) : null;
    const isToday = i === today;
    return `<div class="oz-row${isToday?' today':''}">
      <div class="oz-day">${d}${isToday?' ◀':''}</div>
      <div class="oz-time${!m?' oz-closed':''}">${m ? m[1]+':'+m[2]+' – '+m[3]+':'+m[4] : 'GESCHLOSSEN'}</div>
    </div>`;
  }).join('') + '</div>';
}
```

